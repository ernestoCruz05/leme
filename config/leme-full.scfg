tags {
    initial 3
    maximum 9
    layout dwindle
    drop_mode simple
    tag 2 {
        layout master_stack
        mfact 0.6
        nmaster 1
    }
    tag 4-6 {
        layout accordion
        drop_mode edges
        gap 4
        split_ratio 0.5
        accordion_collapse_width 46
    }
}

style {
    gap 8
    border_width 2
    border_active "#296bb8"
    border_inactive "#3a3a3a"
    opacity_active 1.0
    opacity_inactive 1.0
    # Which layer-shell surfaces a fullscreen window covers.
    # none keeps bars on top, overlay lets nothing through.
    fullscreen_covers top
}

