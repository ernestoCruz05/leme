# A named scratchpad matches this exact Wayland app-id or X11 class. Its
# command is an argument vector, so shell expansion is not available here.
scratchpad "drop" {
    identity "foot-drop"
    spawn foot --app-id foot-drop
    width 0.6
    height 0.6
}

# A list of scratchpads generated with a loop. Uncomment to use:
# lists {
#     pads "term" "music"
# }
# for pad in pads {
#     scratchpad "$pad" {
#         identity "foot-$pad"
#         spawn foot --app-id "foot-$pad"
#     }
# }

keyboard {
    layout pt
    layout us
    options compose:ralt
    repeat_rate 25
    repeat_delay 600
}

output {
    cross_output_focus true
    cross_output_move false
    cross_output_drag true
    warp_cursor true
}

output "DP-1" {
    mode 1920x1080
    refresh 165.0
    scale 1.0
    transform normal
    position 0 0
}

output "DP-2" {
    mode 1920x1080
    refresh 200.0
    scale 1.0
    transform 90
    right_of "DP-1"
}

# Profile-based output selection example (uncomment the profile variable below
# first). LEME_PROFILE comes from the environment, or from a leme.env file beside
# this one -- see config/leme.env for an example:
# if $profile == "laptop" {
#     output "eDP-1" {
#         mode 1920x1080
#         scale 1.25
#     }
# } else {
#     output "DP-1" {
#         mode 1920x1080
#         scale 1.0
#     }
# }

pointer {
    accel_profile adaptive
    accel_speed 0.0
    natural_scroll false
    left_handed false
    tap true
}

pointer "Razer Razer DeathAdder V2" {
    accel_profile flat
    accel_speed 0.0
}

# gestures {
#     workspace_switch {
#         mode single # single, scrub, or free
#         fingers 3
#         distance 300
#         threshold 0.5
#         deceleration 0.997
#         velocity_window 150
#     }
# }

vars {
    mod SUPER
    term foot
    # profile $(env.LEME_PROFILE)
}

bind_group "vt" {
    for i in 1..12 {
        CTRL+ALT+F$i switch_vt $i
    }
}

bind_group "movement" {
    ALT+Left focus left
    ALT+Right focus right
    ALT+Up focus up
    ALT+Down focus down
    $mod+SHIFT+Left move left
    $mod+SHIFT+Right move right
    $mod+SHIFT+Up move up
    $mod+SHIFT+Down move down
}

bind_group "outputs" {
    $mod+comma focus_output left
    $mod+period focus_output right
    $mod+SHIFT+comma move_view_to_output left follow
    $mod+SHIFT+period move_view_to_output right follow
}

bind_group "layouts" {
    $mod+t set_layout dwindle
    $mod+m set_layout master_stack
    $mod+a set_layout accordion
    $mod+w switch_layout
}

bind_group "tags" {
    $mod+Right focus_next_tag
    $mod+Left focus_previous_tag
    $mod+Tab focus_previous_view
    $mod+grave focus_last_tag
    for i in 1..9 {
        $mod+$i focus_tag $i
        $mod+SHIFT+$i move_view_to_tag $i
    }
    $mod+CTRL+Right move_view_to_tag next follow
    $mod+CTRL+Left move_view_to_tag previous follow
    $mod+Delete remove_empty_tag 4
}

bind_group "windows" {
    $mod+v toggle_floating
    # Keep the focused floating window above every tag on this output.
    $mod+s toggle_sticky
    $mod+f toggle_fullscreen
    $mod+q close_view
}

bind_group "scratchpads" {
    # Send the focused window to the scratchpad pool.
    $mod+minus scratchpad_send
    # Show or hide the newest unnamed scratchpad.
    $mod+equal scratchpad_toggle
    # Return the shown scratchpad, or the newest unnamed one, to this tag.
    $mod+SHIFT+minus scratchpad_retrieve
    # Show or hide the named scratchpad declared above.
    $mod+d scratchpad_toggle drop
}

binds "common" {
    inherit vt
    inherit movement
    inherit outputs
    inherit layouts
    inherit tags
    inherit windows
    inherit scratchpads
    $mod+Return spawn $term
    CTRL+ALT+space cycle_keyboard_layout
    $mod+r reload_config
    $mod+space mode resize
    $mod+SHIFT+e quit
}

binds "resize" {
    h resize left 32
    j resize down 32
    k resize up 32
    l resize right 32
    Escape mode common
}

binds "game" {
    escape_exits false
    inherit vt
    inherit outputs
    inherit windows
    $mod+SHIFT+g mode common
}

publication {
    activation follow
}

cursor {
    theme Adwaita
    size 24
}

# Configuration errors are written to the session log and exposed through
# `timao get config`. The accepted config_errors block is reserved for a
# future on-screen report and currently has no visible effect.

env {
    MOZ_ENABLE_WAYLAND 1
}

exec {
    foot --server
}
