diff --git a/render/gles2/shaders/blur_down.frag b/render/gles2/shaders/blur_down.frag
new file mode 100644
index 00000000..ea3bd8c2
--- /dev/null
+++ b/render/gles2/shaders/blur_down.frag
@@ -0,0 +1,25 @@
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+
+varying vec2 v_texcoord;
+uniform sampler2D tex;
+uniform vec2 halfpixel;
+uniform float offset;
+uniform vec4 bounds;
+
+vec4 sample_at(vec2 uv) {
+	return texture2D(tex, clamp(uv, bounds.xy, bounds.zw));
+}
+
+void main() {
+	vec2 d = halfpixel * offset;
+	vec4 sum = sample_at(v_texcoord) * 4.0;
+	sum += sample_at(v_texcoord - d);
+	sum += sample_at(v_texcoord + d);
+	sum += sample_at(v_texcoord + vec2(d.x, -d.y));
+	sum += sample_at(v_texcoord - vec2(d.x, -d.y));
+	gl_FragColor = sum / 8.0;
+}
diff --git a/render/gles2/shaders/blur_finish.frag b/render/gles2/shaders/blur_finish.frag
new file mode 100644
index 00000000..e0c8412a
--- /dev/null
+++ b/render/gles2/shaders/blur_finish.frag
@@ -0,0 +1,48 @@
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+
+varying vec2 v_texcoord;
+varying vec2 v_pos;
+uniform sampler2D tex;
+uniform vec2 halfpixel;
+uniform float offset;
+uniform vec4 bounds;
+uniform float alpha;
+uniform float corner_radius;
+uniform vec2 half_size;
+uniform vec2 mask_offset;
+uniform vec2 mask_scale;
+
+vec4 sample_at(vec2 uv) {
+	return texture2D(tex, clamp(uv, bounds.xy, bounds.zw));
+}
+
+float rounded_box(vec2 p, vec2 b, float r) {
+	vec2 q = abs(p) - b + r;
+	return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
+}
+
+float corner_alpha() {
+	if (corner_radius <= 0.0) {
+		return 1.0;
+	}
+	vec2 p = mask_offset + v_pos * mask_scale;
+	return clamp(0.5 - rounded_box(p, half_size, corner_radius), 0.0, 1.0);
+}
+
+void main() {
+	vec2 d = halfpixel * offset;
+	vec4 sum = sample_at(v_texcoord + vec2(-d.x * 2.0, 0.0));
+	sum += sample_at(v_texcoord + vec2(-d.x, d.y)) * 2.0;
+	sum += sample_at(v_texcoord + vec2(0.0, d.y * 2.0));
+	sum += sample_at(v_texcoord + vec2(d.x, d.y)) * 2.0;
+	sum += sample_at(v_texcoord + vec2(d.x * 2.0, 0.0));
+	sum += sample_at(v_texcoord + vec2(d.x, -d.y)) * 2.0;
+	sum += sample_at(v_texcoord + vec2(0.0, -d.y * 2.0));
+	sum += sample_at(v_texcoord + vec2(-d.x, -d.y)) * 2.0;
+	float a = alpha * corner_alpha();
+	gl_FragColor = vec4(sum.rgb / 12.0 * a, a);
+}
