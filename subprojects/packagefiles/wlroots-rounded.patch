+static bool blur_scratch_ensure(struct wlr_gles2_renderer *renderer,
+		int width, int height, GLenum format) {
+	if (renderer->blur_scratch.format == format &&
+			renderer->blur_scratch.width >= width &&
+			renderer->blur_scratch.height >= height) {
+		return true;
+	}
+
+	if (renderer->blur_scratch.width > width) {
+		width = renderer->blur_scratch.width;
+	}
+	if (renderer->blur_scratch.height > height) {
+		height = renderer->blur_scratch.height;
+	}
+
+	if (renderer->blur_scratch.tex[0] == 0) {
+		glGenTextures(2, renderer->blur_scratch.tex);
+		glGenFramebuffers(2, renderer->blur_scratch.fbo);
+	}
+
+	bool ok = true;
+	for (int i = 0; i < 2; i++) {
+		glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[i]);
+		glTexImage2D(GL_TEXTURE_2D, 0, (GLint)format, width, height, 0,
+			format, GL_UNSIGNED_BYTE, NULL);
+		// Clamping is what keeps the edge of the read region from darkening:
+		// a sample past the edge repeats the edge pixel instead of reading
+		// transparent black.
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+		glBindFramebuffer(GL_FRAMEBUFFER, renderer->blur_scratch.fbo[i]);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+			GL_TEXTURE_2D, renderer->blur_scratch.tex[i], 0);
+		if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+			ok = false;
+			break;
+		}
+	}
+	glBindTexture(GL_TEXTURE_2D, 0);
+
+	if (ok) {
+		renderer->blur_scratch.width = width;
+		renderer->blur_scratch.height = height;
+		renderer->blur_scratch.format = format;
+	}
+	return ok;
+}
+
+/*
+ * Blurs what is already in the framebuffer under `dst_box`, in place, so the
+ * texture that follows composites over a blurred backdrop. Everything behind
+ * has been drawn by now, back to front, so reading the target is enough.
+ *
+ * Separable box blur, matching render/pixman/pass.c. The region is copied out
+ * widened by the radius, blurred horizontally into one scratch target and
+ * vertically into the other, and written back over `dst_box` alone.
+ *
+ * No axis is flipped anywhere in here, which is worth stating because it
+ * looks like it should be. The pass projects with FLIPPED_180, so buffer row
+ * 0 already lands on GL row 0 — the same way a texture is stored. Buffer
+ * coordinates and framebuffer rows therefore agree, and glCopyTexSubImage2D
+ * reads from `span.y` directly.
+ */
+static void backdrop_blur(struct wlr_gles2_render_pass *pass,
+		const struct wlr_box *dst_box, const pixman_region32_t *clip,
+		int radius) {
+	struct wlr_gles2_renderer *renderer = pass->buffer->renderer;
+	int fb_width = pass->buffer->buffer->width;
+	int fb_height = pass->buffer->buffer->height;
+
+	struct wlr_box box = *dst_box;
+	if (!wlr_box_intersection(&box, &box, &(struct wlr_box){
+			0, 0, fb_width, fb_height})) {
+		return;
+	}
+
+	struct wlr_box span = {
+		.x = box.x - radius < 0 ? 0 : box.x - radius,
+		.y = box.y - radius < 0 ? 0 : box.y - radius,
+	};
+	int span_x1 = box.x + box.width + radius;
+	int span_y1 = box.y + box.height + radius;
+	span.width = (span_x1 > fb_width ? fb_width : span_x1) - span.x;
+	span.height = (span_y1 > fb_height ? fb_height : span_y1) - span.y;
+	if (span.width <= 0 || span.height <= 0) {
+		return;
+	}
+
+	// Read the target's own component count: an XRGB output has no alpha to
+	// copy, and asking for one is an error rather than a widening.
+	glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+	GLint alpha_bits = 0;
+	glGetIntegerv(GL_ALPHA_BITS, &alpha_bits);
+
+	if (!blur_scratch_ensure(renderer, span.width, span.height,
+			alpha_bits > 0 ? GL_RGBA : GL_RGB)) {
+		glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+		glViewport(0, 0, fb_width, fb_height);
+		return;
+	}
+	float scratch_width = (float)renderer->blur_scratch.width;
+	float scratch_height = (float)renderer->blur_scratch.height;
+
+	glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+	glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[0]);
+	glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, span.x, span.y,
+		span.width, span.height);
+
+	// Maps scratch coordinates straight onto the scratch framebuffer, with no
+	// flip, so a texel keeps its place across both intermediate passes.
+	float scratch_proj[9] = {
+		2.0f / (float)span.width, 0.0f, -1.0f,
+		0.0f, 2.0f / (float)span.height, -1.0f,
+		0.0f, 0.0f, 1.0f,
+	};
+	struct wlr_box span_box = {0, 0, span.width, span.height};
+	struct wlr_fbox span_uv = {
+		.x = 0.0f,
+		.y = 0.0f,
+		.width = (float)span.width / scratch_width,
+		.height = (float)span.height / scratch_height,
+	};
+
+	glDisable(GL_BLEND);
+	glUseProgram(renderer->shaders.blur.program);
+	glUniform1i(renderer->shaders.blur.tex, 0);
+	glUniform1f(renderer->shaders.blur.radius, (float)radius);
+	glActiveTexture(GL_TEXTURE0);
+	glViewport(0, 0, span.width, span.height);
+
+	glBindFramebuffer(GL_FRAMEBUFFER, renderer->blur_scratch.fbo[1]);
+	glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[0]);
+	glUniform2f(renderer->shaders.blur.direction, 1.0f / scratch_width, 0.0f);
+	set_proj_matrix(renderer->shaders.blur.proj, scratch_proj, &span_box);
+	set_tex_matrix(renderer->shaders.blur.tex_proj,
+		WL_OUTPUT_TRANSFORM_NORMAL, &span_uv);
+	render(&span_box, NULL, renderer->shaders.blur.pos_attrib);
+
+	glBindFramebuffer(GL_FRAMEBUFFER, renderer->blur_scratch.fbo[0]);
+	glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[1]);
+	glUniform2f(renderer->shaders.blur.direction, 0.0f, 1.0f / scratch_height);
+	set_proj_matrix(renderer->shaders.blur.proj, scratch_proj, &span_box);
+	set_tex_matrix(renderer->shaders.blur.tex_proj,
+		WL_OUTPUT_TRANSFORM_NORMAL, &span_uv);
+	render(&span_box, NULL, renderer->shaders.blur.pos_attrib);
+
+	// Back to the framebuffer. A zero radius makes the shader a plain copy,
+	// so this writes the blurred span back over the destination alone.
+	glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+	glViewport(0, 0, fb_width, fb_height);
+	glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[0]);
+	struct wlr_fbox src_uv = {
+		.x = (float)(box.x - span.x) / scratch_width,
+		.y = (float)(box.y - span.y) / scratch_height,
+		.width = (float)box.width / scratch_width,
+		.height = (float)box.height / scratch_height,
+	};
+	glUniform2f(renderer->shaders.blur.direction, 0.0f, 0.0f);
+	glUniform1f(renderer->shaders.blur.radius, 0.0f);
+	set_proj_matrix(renderer->shaders.blur.proj, pass->projection_matrix, &box);
+	set_tex_matrix(renderer->shaders.blur.tex_proj,
+		WL_OUTPUT_TRANSFORM_NORMAL, &src_uv);
+	render(&box, clip, renderer->shaders.blur.pos_attrib);
+
+	glBindTexture(GL_TEXTURE_2D, 0);
+}
