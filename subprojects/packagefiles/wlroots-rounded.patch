+static bool init_blur_shader(struct wlr_gles2_renderer *renderer,
+		struct wlr_gles2_blur_shader *shader, int taps) {
+	char *src = NULL;
+	if (taps >= 0) {
+		size_t len = strlen(blur_frag_src) + 32;
+		src = malloc(len);
+		if (src == NULL) {
+			return false;
+		}
+		snprintf(src, len, "#define BLUR_TAPS %d\n%s", taps, blur_frag_src);
+	}
+
+	GLuint prog = link_program(renderer, common_vert_src,
+		src != NULL ? src : blur_frag_src);
+	free(src);
+	if (!prog) {
+		return false;
+	}
+
+	shader->taps = taps;
+	shader->program = prog;
+	shader->proj = glGetUniformLocation(prog, "proj");
+	shader->tex_proj = glGetUniformLocation(prog, "tex_proj");
+	shader->tex = glGetUniformLocation(prog, "tex");
+	shader->direction = glGetUniformLocation(prog, "direction");
+	shader->radius = glGetUniformLocation(prog, "radius");
+	shader->pos_attrib = glGetAttribLocation(prog, "pos");
+	return true;
+}
+
+const struct wlr_gles2_blur_shader *gles2_get_blur_shader(
+		struct wlr_gles2_renderer *renderer, int taps) {
+	size_t cache_len =
+		sizeof(renderer->shaders.blur_cache) /
+		sizeof(renderer->shaders.blur_cache[0]);
+
+	if (taps < 0 || taps > 64) {
+		return &renderer->shaders.blur;
+	}
+
+	for (size_t i = 0; i < cache_len; i++) {
+		struct wlr_gles2_blur_shader *entry = &renderer->shaders.blur_cache[i];
+		if (entry->program != 0 && entry->taps == taps) {
+			return entry;
+		}
+	}
+
+	for (size_t i = 0; i < cache_len; i++) {
+		struct wlr_gles2_blur_shader *entry = &renderer->shaders.blur_cache[i];
+		if (entry->program == 0) {
+			if (!init_blur_shader(renderer, entry, taps)) {
+				return &renderer->shaders.blur;
+			}
+			return entry;
+		}
+	}
+
+	return &renderer->shaders.blur;
+}
