+static void backdrop_blur(struct wlr_pixman_buffer *buffer,
+		const struct wlr_box *box, int radius) {
+	uint32_t *data = pixman_image_get_data(buffer->image);
+	int stride = pixman_image_get_stride(buffer->image) / 4;
+	int image_width = pixman_image_get_width(buffer->image);
+	int image_height = pixman_image_get_height(buffer->image);
