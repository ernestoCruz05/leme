+	int x0 = box->x < 0 ? 0 : box->x;
+	int y0 = box->y < 0 ? 0 : box->y;
+	int x1 = box->x + box->width;
+	int y1 = box->y + box->height;
+	x1 = x1 > image_width ? image_width : x1;
+	y1 = y1 > image_height ? image_height : y1;
+	if (data == NULL || x1 <= x0 || y1 <= y0 || radius <= 0) {
+		return;
+	}
+
+	int ex0 = x0 - radius < 0 ? 0 : x0 - radius;
+	int ey0 = y0 - radius < 0 ? 0 : y0 - radius;
+	int ex1 = x1 + radius > image_width ? image_width : x1 + radius;
+	int ey1 = y1 + radius > image_height ? image_height : y1 + radius;
+	int span_width = ex1 - ex0;
+	int span_height = ey1 - ey0;
+
+	uint32_t *scratch = malloc((size_t)span_width * (size_t)span_height *
+		sizeof(*scratch));
+	if (scratch == NULL) {
+		return;
+	}
+
+	for (int y = ey0; y < ey1; y++) {
+		for (int x = ex0; x < ex1; x++) {
+			uint32_t total[4] = {0, 0, 0, 0};
+			int count = 0;
+			for (int offset = -radius; offset <= radius; offset++) {
+				int sample = x + offset;
+				if (sample < 0 || sample >= image_width) {
+					continue;
