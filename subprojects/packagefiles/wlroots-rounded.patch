 	}
 }
 
+static int blur_level_size(int size, int level) {
+	return (size + (1 << level) - 1) >> level;
+}
+
+static bool blur_scratch_ensure(struct wlr_gles2_renderer *renderer,
+		int width, int height, GLenum format) {
+	if (renderer->blur_scratch.format == format &&
+			renderer->blur_scratch.width >= width &&
+			renderer->blur_scratch.height >= height) {
+		return true;
+	}
+
+	if (renderer->blur_scratch.width > width) {
+		width = renderer->blur_scratch.width;
+	}
+	if (renderer->blur_scratch.height > height) {
+		height = renderer->blur_scratch.height;
+	}
+
+	if (renderer->blur_scratch.tex[0] == 0) {
+		glGenTextures(WLR_GLES2_BLUR_LEVELS, renderer->blur_scratch.tex);
+		glGenFramebuffers(WLR_GLES2_BLUR_LEVELS, renderer->blur_scratch.fbo);
+	}
+
+	bool ok = true;
+	for (int i = 0; i < WLR_GLES2_BLUR_LEVELS; i++) {
+		glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[i]);
+		glTexImage2D(GL_TEXTURE_2D, 0, (GLint)format,
+			blur_level_size(width, i), blur_level_size(height, i), 0,
+			format, GL_UNSIGNED_BYTE, NULL);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+		glBindFramebuffer(GL_FRAMEBUFFER, renderer->blur_scratch.fbo[i]);
+		glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+			GL_TEXTURE_2D, renderer->blur_scratch.tex[i], 0);
+		if (glCheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE) {
+			ok = false;
+			break;
+		}
+	}
+	glBindTexture(GL_TEXTURE_2D, 0);
+
+	if (ok) {
+		renderer->blur_scratch.width = width;
+		renderer->blur_scratch.height = height;
+		renderer->blur_scratch.format = format;
+	}
+	return ok;
+}
+
+struct blur_levels {
+	int width[WLR_GLES2_BLUR_LEVELS];
+	int height[WLR_GLES2_BLUR_LEVELS];
+	int alloc_width[WLR_GLES2_BLUR_LEVELS];
+	int alloc_height[WLR_GLES2_BLUR_LEVELS];
+};
+
+static void blur_bind_source(const struct wlr_gles2_blur_shader *shader,
+		GLuint texture, const struct blur_levels *levels, int level,
+		float texels, float offset) {
+	float alloc_width = (float)levels->alloc_width[level];
+	float alloc_height = (float)levels->alloc_height[level];
+
+	glUseProgram(shader->program);
+	glActiveTexture(GL_TEXTURE0);
+	glBindTexture(GL_TEXTURE_2D, texture);
+	glUniform1i(shader->tex, 0);
+	glUniform1f(shader->offset, offset);
+	glUniform2f(shader->halfpixel, texels / alloc_width, texels / alloc_height);
+	glUniform4f(shader->bounds, 0.5f / alloc_width, 0.5f / alloc_height,
+		((float)levels->width[level] - 0.5f) / alloc_width,
+		((float)levels->height[level] - 0.5f) / alloc_height);
+}
+
+static void blur_scratch_pass(struct wlr_gles2_renderer *renderer,
+		const struct wlr_gles2_blur_shader *shader,
+		const struct blur_levels *levels, int source, int target,
+		float offset) {
+	const bool down = target > source;
+	const int width = levels->width[target];
+	const int height = levels->height[target];
+	const float scale = down ? 2.0f : 0.5f;
+
+	blur_bind_source(shader, renderer->blur_scratch.tex[source], levels,
+		source, down ? 1.0f : 0.25f, offset);
+	glBindFramebuffer(GL_FRAMEBUFFER, renderer->blur_scratch.fbo[target]);
+	glViewport(0, 0, width, height);
+
+	float proj[9] = {
+		2.0f / (float)width, 0.0f, -1.0f,
+		0.0f, 2.0f / (float)height, -1.0f,
+		0.0f, 0.0f, 1.0f,
+	};
+	struct wlr_box quad = {0, 0, width, height};
+	struct wlr_fbox uv = {
+		.width = (float)width * scale / (float)levels->alloc_width[source],
+		.height = (float)height * scale / (float)levels->alloc_height[source],
+	};
+	set_proj_matrix(shader->proj, proj, &quad);
+	set_tex_matrix(shader->tex_proj, WL_OUTPUT_TRANSFORM_NORMAL, &uv);
+	render(&quad, NULL, shader->pos_attrib);
+}
+
+struct blur_target {
+	const struct wlr_box *dst_box;
+	const struct wlr_box *corner_box;
+	float corner_radius;
+	float alpha;
+	struct wlr_blur_params params;
+	GLenum format;
+};
+
+static void set_corner_mask(GLint offset, GLint scale, GLint half_size,
+		const struct wlr_box *dst_box, const struct wlr_box *corner_box) {
+	glUniform2f(offset,
+		(float)dst_box->x - ((float)corner_box->x + (float)corner_box->width / 2.0f),
+		(float)dst_box->y - ((float)corner_box->y + (float)corner_box->height / 2.0f));
+	glUniform2f(scale, (float)dst_box->width, (float)dst_box->height);
+	glUniform2f(half_size,
+		(float)corner_box->width / 2.0f, (float)corner_box->height / 2.0f);
+}
+
+static struct wlr_box blur_span(const struct wlr_box *area, int reach,
+		int fb_width, int fb_height) {
+	struct wlr_box span = {
+		.x = area->x - reach < 0 ? 0 : area->x - reach,
+		.y = area->y - reach < 0 ? 0 : area->y - reach,
+	};
+	int span_x1 = area->x + area->width + reach;
+	int span_y1 = area->y + area->height + reach;
+	span.width = (span_x1 > fb_width ? fb_width : span_x1) - span.x;
+	span.height = (span_y1 > fb_height ? fb_height : span_y1) - span.y;
+	return span;
+}
+
+static int64_t blur_span_cost(const pixman_box32_t *area, int reach,
+		int fb_width, int fb_height) {
+	struct wlr_box box = {
+		.x = area->x1,
+		.y = area->y1,
+		.width = area->x2 - area->x1,
+		.height = area->y2 - area->y1,
+	};
+	struct wlr_box span = blur_span(&box, reach, fb_width, fb_height);
+	if (span.width <= 0 || span.height <= 0) {
+		return 0;
+	}
+	return (int64_t)span.width * span.height;
+}
+
+static bool blur_spans_disjoint(const pixman_box32_t *rects, int count,
+		int reach) {
+	for (int i = 0; i < count; i++) {
+		for (int j = i + 1; j < count; j++) {
+			if (rects[i].x1 - reach < rects[j].x2 + reach &&
+					rects[j].x1 - reach < rects[i].x2 + reach &&
+					rects[i].y1 - reach < rects[j].y2 + reach &&
+					rects[j].y1 - reach < rects[i].y2 + reach) {
+				return false;
+			}
+		}
+	}
+	return true;
+}
+
+static void backdrop_blur_area(struct wlr_gles2_render_pass *pass,
+		const struct blur_target *target, const pixman_box32_t *area,
+		const pixman_region32_t *clip) {
+	struct wlr_gles2_renderer *renderer = pass->buffer->renderer;
+	int fb_width = pass->buffer->buffer->width;
+	int fb_height = pass->buffer->buffer->height;
+	const struct wlr_blur_params *params = &target->params;
+	const struct wlr_box *dst_box = target->dst_box;
+
+	struct wlr_box box = {
+		.x = area->x1,
+		.y = area->y1,
+		.width = area->x2 - area->x1,
+		.height = area->y2 - area->y1,
+	};
+	struct wlr_box span = blur_span(&box, params->reach, fb_width, fb_height);
+	if (span.width <= 0 || span.height <= 0) {
+		return;
+	}
+
+	if (!blur_scratch_ensure(renderer, span.width, span.height, target->format)) {
+		glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+		glViewport(0, 0, fb_width, fb_height);
+		return;
+	}
+
+	struct blur_levels levels = {0};
+	for (int i = 0; i <= params->passes; i++) {
+		levels.width[i] = blur_level_size(span.width, i);
+		levels.height[i] = blur_level_size(span.height, i);
+		levels.alloc_width[i] =
+			blur_level_size(renderer->blur_scratch.width, i);
+		levels.alloc_height[i] =
+			blur_level_size(renderer->blur_scratch.height, i);
+	}
+
+	glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+	glBindTexture(GL_TEXTURE_2D, renderer->blur_scratch.tex[0]);
+	glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, span.x, span.y,
+		span.width, span.height);
+
+	glDisable(GL_BLEND);
+	for (int i = 1; i <= params->passes; i++) {
+		blur_scratch_pass(renderer, &renderer->shaders.blur_down, &levels,
+			i - 1, i, params->offset);
+	}
+	for (int i = params->passes; i > 1; i--) {
+		blur_scratch_pass(renderer, &renderer->shaders.blur_up, &levels,
+			i, i - 1, params->offset);
+	}
+
+	glBindFramebuffer(GL_FRAMEBUFFER, gles2_buffer_get_fbo(pass->buffer));
+	glViewport(0, 0, fb_width, fb_height);
+	setup_blending(WLR_RENDER_BLEND_MODE_PREMULTIPLIED);
+
+	const struct wlr_gles2_blur_shader *finish = &renderer->shaders.blur_finish;
+	float level_width = 2.0f * (float)levels.alloc_width[1];
+	float level_height = 2.0f * (float)levels.alloc_height[1];
+	struct wlr_fbox uv = {
+		.x = (float)(dst_box->x - span.x) / level_width,
+		.y = (float)(dst_box->y - span.y) / level_height,
+		.width = (float)dst_box->width / level_width,
+		.height = (float)dst_box->height / level_height,
+	};
+	blur_bind_source(finish, renderer->blur_scratch.tex[1], &levels, 1,
+		0.25f, params->offset);
+	glUniform1f(finish->alpha, target->alpha > 1.0f ? 1.0f : target->alpha);
+	glUniform1f(finish->corner_radius, target->corner_radius);
+	set_corner_mask(finish->mask_offset, finish->mask_scale, finish->half_size,
+		dst_box, target->corner_box);
+	set_proj_matrix(finish->proj, pass->projection_matrix, dst_box);
+	set_tex_matrix(finish->tex_proj, WL_OUTPUT_TRANSFORM_NORMAL, &uv);
+	render(dst_box, clip, finish->pos_attrib);
+
+	glBindTexture(GL_TEXTURE_2D, 0);
+}
+
