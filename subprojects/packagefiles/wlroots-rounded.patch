diff --git a/render/gles2/shaders/blur.frag b/render/gles2/shaders/blur.frag
new file mode 100644
index 0000000..b837e4e
--- /dev/null
+++ b/render/gles2/shaders/blur.frag
@@ -0,0 +1,28 @@
+#ifdef GL_FRAGMENT_PRECISION_HIGH
+precision highp float;
+#else
+precision mediump float;
+#endif
+
+varying vec2 v_texcoord;
+uniform sampler2D tex;
+uniform vec2 direction;
+uniform float radius;
+
+// One half of a separable box blur, matching the pixman renderer so the two
+// agree. GLSL ES 1.00 needs a constant loop bound, so the radius is applied
+// by skipping samples instead. 64 is the widest radius the compositor
+// accepts.
+void main() {
+	vec4 total = vec4(0.0);
+	float count = 0.0;
+	for (int i = 0; i <= 128; i++) {
+		float offset = float(i) - 64.0;
+		if (abs(offset) > radius) {
+			continue;
+		}
+		total += texture2D(tex, v_texcoord + direction * offset);
+		count += 1.0;
+	}
+	gl_FragColor = total / count;
+}
