+				for (int channel = 0; channel < 4; channel++) {
+					total[channel] += (pixel >> (channel * 8)) & 0xff;
+				}
+				count++;
+			}
+			uint32_t blended = 0;
+			for (int channel = 0; channel < 4; channel++) {
+				blended |= (total[channel] / (uint32_t)count) <<
+					(channel * 8);
+			}
+			scratch[(size_t)(y - ey0) * (size_t)span_width +
+				(size_t)(x - ex0)] = blended;
+		}
+	}
+
+	for (int y = y0; y < y1; y++) {
+		for (int x = x0; x < x1; x++) {
+			uint32_t total[4] = {0, 0, 0, 0};
+			int count = 0;
+			for (int offset = -radius; offset <= radius; offset++) {
+				int sample = y + offset;
+				if (sample < ey0 || sample >= ey1) {
+					continue;
+				}
+				uint32_t pixel = scratch[(size_t)(sample - ey0) *
+					(size_t)span_width + (size_t)(x - ex0)];
+				for (int channel = 0; channel < 4; channel++) {
+					total[channel] += (pixel >> (channel * 8)) & 0xff;
+				}
+				count++;
+			}
+			uint32_t blended = 0;
+			for (int channel = 0; channel < 4; channel++) {
+				blended |= (total[channel] / (uint32_t)count) <<
+					(channel * 8);
+			}
+			data[(size_t)y * (size_t)stride + (size_t)x] = blended;
+		}
