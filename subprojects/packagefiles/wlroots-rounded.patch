+static pixman_image_t *corner_mask_create(int width, int height,
+		float radius, float thickness, float alpha, uint8_t **out_data) {
+	int stride = (width + 3) & ~3;
+	uint8_t *data = calloc((size_t)stride * (size_t)height, 1);
+	if (data == NULL) {
+		return NULL;
+	}
+
+	float half_width = (float)width / 2.0f;
+	float half_height = (float)height / 2.0f;
+	if (radius > half_width) {
+		radius = half_width;
+	}
+	if (radius > half_height) {
+		radius = half_height;
+	}
+
+	for (int y = 0; y < height; y++) {
+		for (int x = 0; x < width; x++) {
+			float px = ((float)x + 0.5f) - half_width;
+			float py = ((float)y + 0.5f) - half_height;
+			float distance = rounded_box_distance(px, py, half_width,
+				half_height, radius);
+			float coverage = 1.0f - fminf(fmaxf(distance + 0.5f, 0.0f), 1.0f);
+
+			if (thickness > 0.0f) {
+				float inner_radius = fmaxf(radius - thickness, 0.0f);
+				float inner = rounded_box_distance(px, py,
+					half_width - thickness, half_height - thickness,
+					inner_radius);
+
+				coverage *= fminf(fmaxf(inner + 0.5f, 0.0f), 1.0f);
+			}
+			data[(size_t)y * (size_t)stride + (size_t)x] =
+				(uint8_t)(coverage * alpha * 255.0f + 0.5f);
+		}
+	}
+
+	pixman_image_t *mask = pixman_image_create_bits(PIXMAN_a8, width, height,
+		(uint32_t *)(void *)data, stride);
+	if (mask == NULL) {
+		free(data);
+		return NULL;
+	}
+	*out_data = data;
+	return mask;
+}
