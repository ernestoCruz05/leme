diff --git a/render/blur.c b/render/blur.c
new file mode 100644
index 00000000..a0398286
--- /dev/null
+++ b/render/blur.c
@@ -0,0 +1,29 @@
+#include <math.h>
+#include "render/blur.h"
+
+struct wlr_blur_params wlr_blur_params_for_radius(float radius) {
+	struct wlr_blur_params params = {0};
+	if (!(radius > 0.0f) || !isfinite(radius)) {
+		return params;
+	}
+
+	int passes = (int)ceilf(log2f(radius)) - 1;
+	if (passes < 1) {
+		passes = 1;
+	} else if (passes > WLR_BLUR_MAX_PASSES) {
+		passes = WLR_BLUR_MAX_PASSES;
+	}
+
+	float offset = radius / (float)(1 << passes);
+	if (offset < 0.5f) {
+		offset = 0.5f;
+	} else if (offset > 3.0f) {
+		offset = 3.0f;
+	}
+
+	params.passes = passes;
+	params.offset = offset;
+	params.reach = (int)ceilf((2.0f * offset + 3.0f) *
+		(float)((1 << passes) - 1));
+	return params;
+}
